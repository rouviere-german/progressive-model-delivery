# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=progressive-model-delivery
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys.
# Generate a key with: uv run progressive-model-delivery generate-api-key
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

APP_DATA_DIR=var
APP_REGISTRY_DIR=var/registry
APP_CONTROL_DB=var/control.sqlite
APP_PREDLOG_DIR=var/predlog

# Comma-separated base64 Ed25519 public keys of the release signer(s).
# Create a key pair with: uv run progressive-model-delivery keygen --out var/keys
APP_TRUSTED_SIGNING_KEYS=

# Router. The HMAC secret for subject ids (>= 16 chars) is required to serve predictions.
APP_SUBJECT_HASH_SECRET=
APP_LABEL_TTL_SECONDS=3600
APP_REQUEST_INDEX_CAPACITY=200000
APP_FEEDBACK_RATE_PER_SECOND=50
APP_FEEDBACK_BURST=200
APP_STATE_REFRESH_SECONDS=1.0
APP_LOG_FLUSH_SECONDS=1.0

# Shadow path (router -> shadow worker on the internal network). The token is shared by both.
APP_SHADOW_URL=
APP_SHADOW_TOKEN=
APP_SHADOW_QUEUE_SIZE=1000
APP_SHADOW_WORKERS=4
APP_SHADOW_TIMEOUT_SECONDS=0.5

# Controller and control API. Roles: deployer, release_manager, viewer.
# Example entry: <sha256 of key>:rui:release_manager
APP_ROLE_BINDINGS=
APP_CONTROLLER_ID=controller-1
APP_LEASE_SECONDS=15
APP_RECONCILE_INTERVAL_SECONDS=5
